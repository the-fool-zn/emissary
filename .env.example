# Copy to .env and fill in. Never commit .env. Generate the last three with: python make_hash.py
# --- LLM: any OpenAI-compatible provider ---
# OpenRouter:
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-4.5
# Google AI Studio (free tier):  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Tight free quotas: LLM_MAX_RETRIES=0
ADMIN_USER=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Production only (behind Render/Caddy):
# TRUST_PROXY=1
# EMISSARY_DB=/tmp/emissary.db
